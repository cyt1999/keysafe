# Prisma 数据库配置
# DATABASE_URL="postgresql://production_user:your_strong_password@your_production_db_host:5432/keysafe?schema=public"

# Pinata IPFS 配置（服务器端使用）
PINATA_JWT=your_production_pinata_jwt
PINATA_GATEWAY_URL=your_production_gateway_url

# 管理员API配置
ADMIN_API_KEY=your_production_admin_api_key

# IPFS同步配置（毫秒）
IPFS_SYNC_INTERVAL=86400000  # 24小时

# 会话有效期（毫秒）
SESSION_DURATION=86400000  # 24小时

# 同步CID状态刷新间隔（毫秒）
SYNC_STATUS_INTERVAL=1800000 # 30分钟

# 环境变量
NODE_ENV=production 