// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

model User {
  id            String    @id @default(cuid())
  walletAddress String    @unique
  avatar        String?   // 头像URL
  nickname      String?
  preferences   Json?     // 用户偏好设置
  
  // 主密码验证相关
  masterKeyHash String    // 主密钥哈希，用于验证主密码
  salt         String    // PBKDF2 盐值
  lastLoginAt  DateTime?  // 最后登录时间
  
  // 关联
  dataCids       DataCid[]
  passwords      PasswordEntry[]
  passwordSync   PasswordSync?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model DataCid {
  id          String    @id @default(cuid())
  cid         String    // IPFS CID
  type        CidType   // 数据类型（密码/笔记等）
  status      CidStatus @default(ACTIVE)
  version     Int       @default(1)  // 数据版本
  
  // 关联
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([cid])
}

enum CidType {
  PASSWORDS
  NOTES
  SETTINGS
  OTHER
}

enum CidStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

model PasswordEntry {
  id          String    @id @default(cuid())
  encryptedData String  // 加密后的密码数据
  
  // 关联
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  
  // 元数据
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
}

model PasswordSync {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id])
  lastSyncedAt    DateTime  // 最后同步到IPFS的时间
  lastSyncedCid   String?   // 最后同步的IPFS CID
  syncStatus      String    @default("PENDING") // PENDING, SYNCING, COMPLETED, FAILED
  retryCount      Int       @default(0)
  lastError       String?   // 最后一次同步错误信息
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

